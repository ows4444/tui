import Foundation

#if DEBUG
let level = "debug"
#endif

/// A shape protocol.
protocol Shape { func area() -> Double }

@MainActor
struct Circle: Shape {
    var radius: Double = 1.5
    func area() -> Double { return .pi * radius * radius }
}

