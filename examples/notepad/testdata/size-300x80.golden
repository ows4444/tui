 1 package main                                                                                                                                                                                                                                                                                             
 2                                                                                                                                                                                                                                                                                                          
 3 import "fmt"                                                                                                                                                                                                                                                                                             
 4                                                                                                                                                                                                                                                                                                          
 5 // greet says hello to each name.                                                                                                                                                                                                                                                                        
 6 func greet(names []string) {                                                                                                                                                                                                                                                                             
 7     for _, n := range names {                                                                                                                                                                                                                                                                            
 8         fmt.Println("hello,", n)                                                                                                                                                                                                                                                                         
 9     }                                                                                                                                                                                                                                                                                                    
10 }                                                                                                                                                                                                                                                                                                        
11                                                                                                                                                                                                                                                                                                          
12 func main() {                                                                                                                                                                                                                                                                                            
13     greet([]string{"Ada", "Grace", "Linus"})                                                                                                                                                                                                                                                             
14 }                                                                                                                                                                                                                                                                                                        
