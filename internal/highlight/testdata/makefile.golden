1 Comment "# Build settings"
2 Variable "GO"
2 Plain " ?= go"
3 Variable "PKGS"
3 Plain " := "
3 Variable "$(shell $(GO) list ./...)"
4 Variable "CFLAGS"
4 Plain " += -O2 "
4 Comment "# optimise"
6 Key ".PHONY"
6 Plain ": all test"
7 Key "all"
7 Plain ": build test"
9 Key "build"
9 Plain ": "
9 Variable "$(PKGS)"
9 Plain " main.go"
10 Plain "\t"
10 Variable "$(GO)"
10 Plain " build -o "
10 String "\"bin/app\""
10 Plain " ./cmd/"
10 Variable "$@"
10 Plain "   "
10 Comment "# shell comment, not make's"
12 Keyword "ifeq"
12 Plain " ("
12 Variable "$(OS)"
12 Plain ",Windows_NT)"
13 Variable "EXE"
13 Plain " := .exe"
14 Keyword "else"
15 Variable "EXE"
15 Plain " :="
16 Keyword "endif"
18 Key "clean"
18 Plain ":"
19 Plain "\trm -rf bin "
19 Variable "$${HOME}"
19 Plain "/tmp"
